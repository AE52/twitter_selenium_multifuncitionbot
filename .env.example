# Copy this file to .env and fill in your own values.
TWITTER_USERNAME=your_username_or_email
TWITTER_PASSWORD=your_password
# Optional, only needed when X asks for an extra verification identifier.
TWITTER_VERIFICATION=your_phone_or_email

# Browser behavior
TWITTER_HEADLESS=false
TWITTER_BROWSER=chrome
TWITTER_IMPLICIT_WAIT_SECONDS=5
TWITTER_ACTION_DELAY_SECONDS=2
TWITTER_MAX_ACTIONS_PER_RUN=10
